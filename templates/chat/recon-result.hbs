<div class="bom-chat-card bom-recon-card">
  <h3 class="bom-chat-header">
    <i class="fas fa-binoculars"></i> {{localize "BOM.recon.title"}}
  </h3>
  <div class="bom-recon-detail">
    <span>d20 + {{bonus}} (Wit {{bestWit}}{{#if scoutBonus}} + Scout {{scoutBonus}}{{/if}}) = <strong>{{total}}</strong></span>
  </div>
  <div class="bom-recon-result">
    <strong>{{resultText}}</strong>
  </div>
</div>
