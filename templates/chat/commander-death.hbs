<div class="bom-chat-card bom-commander-death-card">
  <h3 class="bom-chat-header bom-death">
    <i class="fas fa-skull"></i> {{localize "BOM.chat.commanderDeath"}}
  </h3>
  <div class="bom-death-detail">
    <strong>{{commanderName}}</strong> of <em>{{legionName}}</em> has fallen.
    {{#if cause}}<p>{{cause}}</p>{{/if}}
  </div>
</div>
