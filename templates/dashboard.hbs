<div class="mytros-dashboard">
    <nav class="tabs">
        <a class="item {{#if (eq tab 'overview')}}active{{/if}}" data-action="changeTab" data-tab="overview"><i class="fas fa-map-marked-alt"></i> {{localize "MYTROS.TabOverview"}}</a>
        <a class="item {{#if (eq tab 'miracles')}}active{{/if}}" data-action="changeTab" data-tab="miracles"><i class="fas fa-sun"></i> {{localize "MYTROS.TabMiracles"}}</a>
        {{#if isGM}}
        <a class="item {{#if (eq tab 'setup')}}active{{/if}}" data-action="changeTab" data-tab="setup"><i class="fas fa-cog"></i> {{localize "MYTROS.TabSetup"}}</a>
        {{/if}}
    </nav>

    <header class="dashboard-header">
        <div class="round-label">{{localize "MYTROS.Round"}} {{round}}</div>
        <div class="phase-track">
            {{#each phaseNames}}
            <div class="phase-pip {{#if (eq (add @index 1) @root.phase)}}active{{/if}}" title="{{localize "MYTROS.Phase"}} {{add @index 1}}: {{this}}">
                <span class="pip-number">{{add @index 1}}</span>
                <span class="pip-label">{{this}}</span>
            </div>
            {{/each}}
        </div>
        {{#if isGM}}
        <div class="phase-controls">
            <button type="button" class="phase-btn" data-action="prevPhase" {{#if (eq phase 1)}}disabled{{/if}} title="{{localize "MYTROS.PrevPhase"}}"><i class="fas fa-chevron-left"></i></button>
            <span class="phase-current-label">{{phaseName}}</span>
            {{#if (eq phase 5)}}
            <button type="button" class="phase-btn phase-btn-advance" data-action="advanceRound" title="{{localize "MYTROS.AdvanceRoundTooltip"}}">
                {{localize "MYTROS.AdvanceRound"}} {{round}} + 1 <i class="fas fa-forward"></i>
            </button>
            {{else}}
            <button type="button" class="phase-btn phase-btn-next" data-action="nextPhase" title="{{localize "MYTROS.NextPhase"}}"><i class="fas fa-chevron-right"></i></button>
            {{/if}}
        </div>
        {{/if}}
    </header>

    <main class="dashboard-body">
        {{#if (eq tab 'overview')}}
            {{#if isBattleScene}}
            {{#if @root.isGM}}
            <div class="recon-panel">
                <div class="recon-header">
                    <strong><i class="fas fa-eye"></i> {{localize "MYTROS.ReconTitle"}}</strong>
                    <button type="button" class="recon-btn" data-action="rollRecon"><i class="fas fa-dice-d20"></i> {{localize "MYTROS.ReconButton"}}</button>
                </div>
                {{#if reconResult}}
                <div class="recon-result {{#if reconBonus}}recon-bonus{{/if}}">
                    {{#if reconBonus}}<i class="fas fa-star"></i> {{/if}}{{reconResult}}
                </div>
                {{/if}}
                {{#if deathTollFrozen}}
                <div class="recon-result recon-frozen"><i class="fas fa-lock"></i> {{localize "MYTROS.ReconFrozen"}}</div>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
            {{#if isBattleScene}}
                <div class="sections-list">
                    {{#each sections}}
                        <div class="section-card control-{{this.control}}">
                            <div class="section-header">
                                <h3>{{this.name}}</h3>
                                {{#if @root.isGM}}
                                <div class="section-controls">
                                    {{#if this.pendingBattle}}
                                    <button type="button" class="resolve-btn" data-action="openResolver" data-region-id="{{this.id}}"><i class="fas fa-swords"></i> {{localize "MYTROS.ResolveBattle"}}</button>
                                    {{/if}}
                                    {{#if this.routedContested}}
                                    <button type="button" class="resolve-btn resolve-rout" data-action="disbandRoutedLegions" data-region-id="{{this.id}}"><i class="fas fa-flag"></i> {{localize "MYTROS.OverrunRouted"}}</button>
                                    {{/if}}
                                    <select data-action="setSectionControl" data-region-id="{{this.id}}">
                                        <option value="neutral" {{#if (eq this.control 'neutral')}}selected{{/if}}>{{localize "MYTROS.ControlNeutral"}}</option>
                                        <option value="allied" {{#if (eq this.control 'allied')}}selected{{/if}}>{{localize "MYTROS.ControlAllied"}}</option>
                                        <option value="sydon" {{#if (eq this.control 'sydon')}}selected{{/if}}>{{localize "MYTROS.ControlSydon"}}</option>
                                    </select>
                                    <button type="button" data-action="toggleSectionFlag" data-region-id="{{this.id}}" data-flag="fortified" class="{{#if this.fortified}}active{{/if}}" title="{{localize "MYTROS.FortifiedLabel"}}"><i class="fas fa-shield-alt"></i></button>
                                    <button type="button" data-action="toggleSectionFlag" data-region-id="{{this.id}}" data-flag="hasObjective" class="{{#if this.hasObjective}}active{{/if}}" title="{{localize "MYTROS.ObjectiveLabel"}}"><i class="fas fa-star"></i></button>
                                </div>
                                {{else}}
                                <div class="section-badges">
                                    {{#if this.fortified}}<span class="badge fortified" title="{{localize "MYTROS.FortifiedLabel"}}"><i class="fas fa-shield-alt"></i></span>{{/if}}
                                    {{#if this.hasObjective}}<span class="badge objective" title="{{localize "MYTROS.ObjectiveLabel"}}"><i class="fas fa-star"></i></span>{{/if}}
                                    {{#if this.objectiveDestroyed}}<span class="badge destroyed" title="{{localize "MYTROS.ObjectiveDestroyedLabel"}}"><i class="fas fa-fire"></i></span>{{/if}}
                                </div>
                                {{/if}}
                            </div>
                            <div class="section-legions">
                                {{#if this.legions.length}}
                                    <ul>
                                    {{#each this.legions}}
                                        <li class="legion-item faction-{{this.faction}}{{#if this.isRouted}} is-routed{{/if}}{{#if this.isDestroyed}} is-destroyed{{/if}}">
                                            <div class="legion-header">
                                                <span class="legion-name">{{this.name}}</span>
                                                <span class="legion-stats">{{localize "MYTROS.InjShort"}} {{this.injuries}} · {{localize "MYTROS.MorShort"}} {{this.morale}}</span>
                                                {{#if @root.isGM}}
                                                <button type="button" data-action="toggleLegionFlag" data-legion-id="{{this.id}}" data-flag="movedThree" class="legion-flag-btn {{#if this.movedThree}}active{{/if}}" title="{{localize "MYTROS.VanguardLabel"}}">
                                                    <i class="fas fa-horse"></i>
                                                </button>
                                                {{/if}}
                                                {{#if this.isRouted}}<span class="badge routed" title="{{localize "MYTROS.Routed"}}"><i class="fas fa-flag"></i> {{localize "MYTROS.Routed"}}</span>{{/if}}
                                                {{#if this.isDestroyed}}<span class="badge destroyed" title="{{localize "MYTROS.Destroyed"}}"><i class="fas fa-skull"></i> {{localize "MYTROS.Destroyed"}}</span>{{/if}}
                                            </div>
                                            {{#if @root.isGM}}
                                                <select data-action="assignCommander" data-legion-id="{{this.id}}">
                                                    <option value="">{{localize "MYTROS.NoCommander"}}</option>
                                                    {{#each @root.commanders}}
                                                        <option value="{{this.id}}" {{#if (eq this.id ../commanderId)}}selected{{/if}}>{{this.name}}</option>
                                                    {{/each}}
                                                </select>
                                            {{else}}
                                                {{#if this.commanderId}}
                                                    <span class="commander-tag"><i class="fas fa-user-crown"></i> {{this.commanderName}}</span>
                                                {{/if}}
                                            {{/if}}
                                        </li>
                                    {{/each}}
                                    </ul>
                                {{else}}
                                    <p class="empty-state">{{localize "MYTROS.NoLegions"}}</p>
                                {{/if}}
                            </div>

                            {{#if this.supportUnits.length}}
                            <div class="support-units">
                                <h4><i class="fas fa-users"></i> {{localize "MYTROS.Support"}}</h4>
                                {{#each this.supportUnits}}
                                <div class="support-item">
                                    <span>{{this.name}}</span>
                                    {{#if (eq @root.phase 3)}}
                                        {{#if @root.isGM}}
                                        <select data-action="setDeploymentMode" data-token-id="{{this.id}}">
                                            <option value="none">{{localize "MYTROS.DeployNone"}}</option>
                                            <option value="reinforce" {{#if (eq this.deploymentMode 'reinforce')}}selected{{/if}}>{{localize "MYTROS.DeployReinforce"}}</option>
                                            <option value="shock_assault" {{#if (eq this.deploymentMode 'shock_assault')}}selected{{/if}}>{{localize "MYTROS.DeployShockAssault"}}</option>
                                            <option value="targeted_strike_maneuver" {{#if (eq this.deploymentMode 'targeted_strike_maneuver')}}selected{{/if}}>{{localize "MYTROS.DeployTargetedManeuver"}}</option>
                                            <option value="targeted_strike_charge" {{#if (eq this.deploymentMode 'targeted_strike_charge')}}selected{{/if}}>{{localize "MYTROS.DeployTargetedCharge"}}</option>
                                            <option value="targeted_strike_clash" {{#if (eq this.deploymentMode 'targeted_strike_clash')}}selected{{/if}}>{{localize "MYTROS.DeployTargetedClash"}}</option>
                                            <option value="shield_the_wounded" {{#if (eq this.deploymentMode 'shield_the_wounded')}}selected{{/if}}>{{localize "MYTROS.DeployShield"}}</option>
                                            <option value="protect" {{#if (eq this.deploymentMode 'protect')}}selected{{/if}}>{{localize "MYTROS.DeployProtect"}}</option>
                                            <option value="rest" {{#if (eq this.deploymentMode 'rest')}}selected{{/if}}>{{localize "MYTROS.DeployRest"}}</option>
                                        </select>
                                        {{/if}}
                                    {{else}}
                                        {{#if (ne this.deploymentMode 'none')}}
                                            <span class="support-mode-badge">{{this.deploymentMode}}</span>
                                        {{/if}}
                                    {{/if}}
                                </div>
                                {{/each}}
                            </div>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="warning">{{localize "MYTROS.NoBattleScene"}}</p>
            {{/if}}
        {{/if}}

        {{#if (eq tab 'miracles')}}
            <div class="miracles-panel">
                <div class="miracle-pools">
                    <div class="miracle-pool pool-allied">
                        <h3><i class="fas fa-sun"></i> {{localize "MYTROS.AlliedMiracles"}}</h3>
                        <div class="pool-count">{{alliedMiracles}}</div>
                        {{#if isGM}}
                        <div class="miracle-spend-group">
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="1"><i class="fas fa-dice-d20"></i> {{localize "MYTROS.SpendRollBonus"}}</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="2"><i class="fas fa-star"></i> {{localize "MYTROS.SpendDivineAdvantage"}}</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="2"><i class="fas fa-campground"></i> {{localize "MYTROS.SpendShortRest"}}</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="4"><i class="fas fa-bed"></i> {{localize "MYTROS.SpendLongRest"}}</button>
                        </div>
                        {{/if}}
                    </div>
                    <div class="miracle-pool pool-sydon">
                        <h3><i class="fas fa-bolt"></i> {{localize "MYTROS.SydonMiracles"}}</h3>
                        <div class="pool-count">{{sydonMiracles}}</div>
                        {{#if isGM}}
                        <div class="miracle-spend-group">
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-cost="1"><i class="fas fa-dice-d20"></i> {{localize "MYTROS.SpendRollBonus"}}</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-cost="2"><i class="fas fa-star"></i> {{localize "MYTROS.SpendDivineAdvantage"}}</button>
                        </div>
                        {{/if}}
                    </div>
                </div>

                {{#if isGM}}
                <hr>
                <h3><i class="fas fa-star"></i> {{localize "MYTROS.MajorEventsTitle"}}</h3>
                <div class="major-events-list">
                    {{#each majorEvents}}
                    <div class="event-item {{#if this.completed}}event-completed{{/if}}">
                        <div class="event-info">
                            <strong>{{this.name}}</strong>
                            <span class="event-desc">{{this.description}}</span>
                        </div>
                        {{#if this.completed}}
                        <span class="event-done"><i class="fas fa-check-circle"></i> {{localize "MYTROS.EventResolved"}} (+{{this.reward}} {{localize "MYTROS.Miracles"}})</span>
                        {{else}}
                        <button type="button" class="event-trigger-btn" data-action="triggerMajorEvent" data-event-id="{{this.id}}">
                            <i class="fas fa-bolt"></i> {{localize "MYTROS.EventTriggerBtn"}} (+{{this.reward}} {{localize "MYTROS.AlliedMiracles"}})
                        </button>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
        {{/if}}

        {{#if (eq tab 'setup')}}
            <div class="setup-form">

                <h3><i class="fas fa-map"></i> {{localize "MYTROS.SetupSectionScene"}}</h3>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupBattleScene"}}</label>
                    <select data-action="updateSetting" data-setting="battleSceneId">
                        <option value="">— {{localize "MYTROS.SetupBattleSceneNone"}} —</option>
                        {{#each scenes}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupSectionPrefix"}}</label>
                    <input type="text" data-action="updateSetting" data-setting="sectionPrefix" value="{{sectionPrefix}}">
                </div>

                <hr>
                <h3><i class="fas fa-calendar"></i> {{localize "MYTROS.SetupBattleState"}}</h3>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupRoundLabel"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="currentRound" value="{{round}}">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupPhaseLabel"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="currentPhase" value="{{phase}}">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.AlliedMiracles"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="alliedMiracles" value="{{alliedMiracles}}">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SydonMiracles"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="sydonMiracles" value="{{sydonMiracles}}">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupDeathTollLabel"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="deathToll" value="{{deathToll}}">
                </div>
                <div class="form-group form-group-checkbox">
                    <label>{{localize "MYTROS.SetupDeathTollFrozen"}}</label>
                    <input type="checkbox" data-action="updateSetting" data-setting="deathTollFrozen" {{#if deathTollFrozen}}checked{{/if}}>
                </div>
                <div class="form-group form-group-checkbox">
                    <label>{{localize "MYTROS.SetupSydonObjectiveHalved"}}</label>
                    <input type="checkbox" data-action="updateSetting" data-setting="sydonObjectiveHalved" {{#if sydonObjectiveHalved}}checked{{/if}}>
                </div>
                <div class="form-group">
                    <button type="button" data-action="resetCompletedEvents" class="btn-danger-subtle"><i class="fas fa-rotate-left"></i> {{localize "MYTROS.SetupResetEvents"}}</button>
                </div>

                <hr>
                <h3><i class="fas fa-sliders"></i> {{localize "MYTROS.SetupRules"}}</h3>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupMaxMorale"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="maxMorale" value="{{maxMorale}}" min="1">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupDestroyThreshold"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="destroyThreshold" value="{{destroyThreshold}}" min="1">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupHopeDC"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="hopeDC" value="{{hopeDC}}" min="1">
                </div>
                <div class="form-group">
                    <label>{{localize "MYTROS.SetupSalvageDC"}}</label>
                    <input type="number" data-action="updateSetting" data-setting="salvageDC" value="{{salvageDC}}" min="1">
                </div>

                <hr>
                <div class="form-group">
                    <button type="button" class="advance-round-btn" data-action="advanceRound"><i class="fas fa-forward"></i> {{localize "MYTROS.AdvanceRound"}} {{round}} + 1</button>
                </div>

                <hr>
                <h3><i class="fas fa-link"></i> {{localize "MYTROS.AdjacencyTitle"}}</h3>
                <p class="adjacency-hint">{{localize "MYTROS.AdjacencyHint"}}</p>
                {{#if adjacencyPairs.length}}
                <div class="adjacency-pairs">
                    {{#each adjacencyPairs}}
                    <div class="adjacency-pair">
                        <span>{{this.aName}} ↔ {{this.bName}}</span>
                        <button type="button" data-action="removeAdjacencyPair" data-index="{{this.index}}">×</button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="adjacency-add-row">
                    <select data-ref="adjA">
                        {{#each sectionOpts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
                    </select>
                    <span>↔</span>
                    <select data-ref="adjB">
                        {{#each sectionOpts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
                    </select>
                    <button type="button" data-action="addAdjacencyPair"><i class="fas fa-plus"></i> {{localize "MYTROS.AdjacencyAdd"}}</button>
                </div>

                <hr>
                <h3><i class="fas fa-database"></i> {{localize "MYTROS.DataManagement"}}</h3>
                <div class="form-group data-mgmt-group">
                    <button type="button" data-action="importCSV" data-type="legion"><i class="fas fa-file-import"></i> {{localize "MYTROS.ImportLegions"}}</button>
                    <button type="button" data-action="exportCSV" data-type="legion"><i class="fas fa-file-export"></i> {{localize "MYTROS.ExportLegions"}}</button>
                </div>
                <div class="form-group data-mgmt-group">
                    <button type="button" data-action="importCSV" data-type="commander"><i class="fas fa-file-import"></i> {{localize "MYTROS.ImportCommanders"}}</button>
                    <button type="button" data-action="exportCSV" data-type="commander"><i class="fas fa-file-export"></i> {{localize "MYTROS.ExportCommanders"}}</button>
                </div>
            </div>
        {{/if}}
    </main>
</div>
