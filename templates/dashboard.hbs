<div class="mytros-dashboard">
    <nav class="tabs">
        <a class="item {{#if (eq tab 'overview')}}active{{/if}}" data-action="changeTab" data-tab="overview">Overview</a>
        <a class="item {{#if (eq tab 'miracles')}}active{{/if}}" data-action="changeTab" data-tab="miracles">Miracles</a>
        {{#if isGM}}
        <a class="item {{#if (eq tab 'setup')}}active{{/if}}" data-action="changeTab" data-tab="setup">Setup</a>
        {{/if}}
    </nav>

    <header class="dashboard-header">
        <h2>Round {{round}} - Phase {{phase}}</h2>
    </header>

    <main class="dashboard-body">
        {{#if (eq tab 'overview')}}
            {{#if isBattleScene}}
            {{#if @root.isGM}}
            <div class="recon-panel">
                <div class="recon-header">
                    <strong><i class="fas fa-eye"></i> Phase 1: Reconnaissance</strong>
                    <button type="button" class="recon-btn" data-action="rollRecon">Roll Recon (1d20 + highest allied Wit)</button>
                </div>
                {{#if reconResult}}
                <div class="recon-result {{#if reconBonus}}recon-bonus{{/if}}">
                    {{#if reconBonus}}<i class="fas fa-star"></i> {{/if}}{{reconResult}}
                </div>
                {{/if}}
                {{#if deathTollFrozen}}
                <div class="recon-result recon-frozen"><i class="fas fa-lock"></i> Death Toll is frozen — Kentimane has been defeated.</div>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}
            {{#if isBattleScene}}
                <div class="sections-list">
                    {{#each sections}}
                        <div class="section-card control-{{this.control}}">
                            <div class="section-header">
                                <h3>{{this.name}}</h3>
                                {{#if @root.isGM}}
                                <div class="section-controls">
                                    {{#if this.pendingBattle}}
                                    <button type="button" class="resolve-btn" data-action="openResolver" data-region-id="{{this.id}}"><i class="fas fa-swords"></i> Resolve Battle</button>
                                    {{/if}}
                                    <select data-action="setSectionControl" data-region-id="{{this.id}}">
                                        <option value="neutral" {{#if (eq this.control 'neutral')}}selected{{/if}}>Neutral</option>
                                        <option value="allied" {{#if (eq this.control 'allied')}}selected{{/if}}>Allied</option>
                                        <option value="sydon" {{#if (eq this.control 'sydon')}}selected{{/if}}>Sydon</option>
                                    </select>
                                    <button type="button" data-action="toggleSectionFlag" data-region-id="{{this.id}}" data-flag="fortified" class="{{#if this.fortified}}active{{/if}}"><i class="fas fa-shield-alt"></i></button>
                                    <button type="button" data-action="toggleSectionFlag" data-region-id="{{this.id}}" data-flag="hasObjective" class="{{#if this.hasObjective}}active{{/if}}"><i class="fas fa-star"></i></button>
                                </div>
                                {{else}}
                                <div class="section-badges">
                                    {{#if this.fortified}}<span class="badge fortified" title="Fortified"><i class="fas fa-shield-alt"></i></span>{{/if}}
                                    {{#if this.hasObjective}}<span class="badge objective" title="Strategic Objective"><i class="fas fa-star"></i></span>{{/if}}
                                    {{#if this.objectiveDestroyed}}<span class="badge destroyed" title="Objective Destroyed"><i class="fas fa-fire"></i></span>{{/if}}
                                </div>
                                {{/if}}
                            </div>
                            <div class="section-legions">
                                {{#if this.legions.length}}
                                    <ul>
                                    {{#each this.legions}}
                                        <li class="legion-item faction-{{this.faction}}{{#if this.isRouted}} is-routed{{/if}}{{#if this.isDestroyed}} is-destroyed{{/if}}">
                                            <div class="legion-header">
                                                <span class="legion-name">{{this.name}}</span>
                                                <span class="legion-stats">Inj {{this.injuries}} · Mor {{this.morale}}</span>
                                                {{#if this.isRouted}}<span class="badge routed" title="Routed"><i class="fas fa-flag"></i></span>{{/if}}
                                                {{#if this.isDestroyed}}<span class="badge destroyed" title="Destroyed"><i class="fas fa-skull"></i></span>{{/if}}
                                            </div>
                                            {{#if @root.isGM}}
                                                <select data-action="assignCommander" data-legion-id="{{this.id}}">
                                                    <option value="">-- No Commander --</option>
                                                    {{#each @root.commanders}}
                                                        <option value="{{this.id}}" {{#if (eq this.id ../commanderId)}}selected{{/if}}>{{this.name}}</option>
                                                    {{/each}}
                                                </select>
                                            {{else}}
                                                {{#if this.commanderId}}
                                                    <span class="commander-tag"><i class="fas fa-user-crown"></i> {{this.commanderName}}</span>
                                                {{/if}}
                                            {{/if}}
                                        </li>
                                    {{/each}}
                                    </ul>
                                {{else}}
                                    <p class="empty-state">No legions present.</p>
                                {{/if}}
                            </div>

                            {{#if this.supportUnits.length}}
                            <div class="support-units" style="margin-top: 5px; padding-top: 5px; border-top: 1px solid #ddd;">
                                <h4 style="font-size: 0.8em; margin: 0; color: #666;">Support</h4>
                                {{#each this.supportUnits}}
                                <div class="support-item" style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9em;">
                                    <span>{{this.name}}</span>
                                    {{#if (eq @root.phase 3)}}
                                        {{#if @root.isGM}}
                                        <select data-action="setDeploymentMode" data-token-id="{{this.id}}">
                                            <option value="none">-- Select Mode --</option>
                                            <option value="reinforce" {{#if (eq this.deploymentMode 'reinforce')}}selected{{/if}}>Reinforce (+1d4 All)</option>
                                            <option value="shock_assault" {{#if (eq this.deploymentMode 'shock_assault')}}selected{{/if}}>Shock Assault (+1d6 Battle)</option>
                                            <option value="targeted_strike" {{#if (eq this.deploymentMode 'targeted_strike')}}selected{{/if}}>Targeted Strike (+1d8/Adv)</option>
                                            <option value="shield_the_wounded" {{#if (eq this.deploymentMode 'shield_the_wounded')}}selected{{/if}}>Shield Wounded (+1d8 Aftermath)</option>
                                            <option value="protect" {{#if (eq this.deploymentMode 'protect')}}selected{{/if}}>Protect (No Casualty Check)</option>
                                        </select>
                                        {{/if}}
                                    {{else}}
                                        {{#if (ne this.deploymentMode 'none')}}
                                            <span class="badge mode-{{this.deploymentMode}}" style="font-size: 0.7em; background: #eee; padding: 2px 4px; border-radius: 3px;">{{this.deploymentMode}}</span>
                                        {{/if}}
                                    {{/if}}
                                </div>
                                {{/each}}
                            </div>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="warning">Please navigate to the designated Battlemap Scene to view sections.</p>
            {{/if}}
        {{/if}}

        {{#if (eq tab 'miracles')}}
            <div class="miracles-panel">
                <div class="miracle-pools">
                    <div class="miracle-pool pool-allied">
                        <h3><i class="fas fa-sun"></i> Allied Miracles</h3>
                        <div class="pool-count">{{alliedMiracles}}</div>
                        {{#if isGM}}
                        <div class="miracle-spend-group">
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="1">−1 Roll Bonus (1pt)</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="2">−2 Divine Advantage (2pt)</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="2">−2 PC Short Rest (2pt)</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="4">−4 PC Long Rest (4pt)</button>
                        </div>
                        {{/if}}
                    </div>
                    <div class="miracle-pool pool-sydon">
                        <h3><i class="fas fa-bolt"></i> Sydon Miracles</h3>
                        <div class="pool-count">{{sydonMiracles}}</div>
                        {{#if isGM}}
                        <div class="miracle-spend-group">
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-cost="1">−1 Roll Bonus (1pt)</button>
                            <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-cost="2">−2 Divine Advantage (2pt)</button>
                        </div>
                        {{/if}}
                    </div>
                </div>

                {{#if isGM}}
                <hr>
                <h3><i class="fas fa-star"></i> Major Events</h3>
                <div class="major-events-list">
                    {{#each majorEvents}}
                    <div class="event-item {{#if this.completed}}event-completed{{/if}}">
                        <div class="event-info">
                            <strong>{{this.name}}</strong>
                            <span class="event-desc">{{this.description}}</span>
                        </div>
                        {{#if this.completed}}
                        <span class="event-done"><i class="fas fa-check-circle"></i> Resolved (+{{this.reward}} Miracles)</span>
                        {{else}}
                        <button type="button" class="event-trigger-btn" data-action="triggerMajorEvent" data-event-id="{{this.id}}">
                            <i class="fas fa-bolt"></i> Resolve (+{{this.reward}} Allied Miracles)
                        </button>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
        {{/if}}

        {{#if (eq tab 'setup')}}
            <div class="setup-form">
                <div class="form-group">
                    <label>Current Round</label>
                    <input type="number" data-action="updateSetting" data-setting="currentRound" value="{{round}}">
                </div>
                <div class="form-group">
                    <label>Current Phase (1-5)</label>
                    <input type="number" data-action="updateSetting" data-setting="currentPhase" value="{{phase}}">
                </div>
                <div class="form-group">
                    <label>Allied Miracles</label>
                    <input type="number" data-action="updateSetting" data-setting="alliedMiracles" value="{{alliedMiracles}}">
                </div>
                <div class="form-group">
                    <label>Sydon Miracles</label>
                    <input type="number" data-action="updateSetting" data-setting="sydonMiracles" value="{{sydonMiracles}}">
                </div>
                <div class="form-group">
                    <label>Civilian Death Toll</label>
                    <input type="number" data-action="updateSetting" data-setting="deathToll" value="{{deathToll}}">
                </div>

                <hr>
                <div class="form-group">
                    <button type="button" class="advance-round-btn" data-action="advanceRound"><i class="fas fa-forward"></i> Advance to Round {{round}} + 1</button>
                </div>

                <hr>
                <h3>Data Management</h3>
                <div class="form-group">
                    <button type="button" data-action="importCSV" data-type="legion"><i class="fas fa-file-import"></i> Import Legions</button>
                    <button type="button" data-action="exportCSV" data-type="legion"><i class="fas fa-file-export"></i> Export Legions</button>
                </div>
                <div class="form-group">
                    <button type="button" data-action="importCSV" data-type="commander"><i class="fas fa-file-import"></i> Import Commanders</button>
                    <button type="button" data-action="exportCSV" data-type="commander"><i class="fas fa-file-export"></i> Export Commanders</button>
                </div>
            </div>
        {{/if}}
    </main>
</div>
