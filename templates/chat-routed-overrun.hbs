<div class="mytros-battle-card">
    <div class="card-header"><i class="fas fa-skull-crossbones"></i> {{title}}</div>
    <div class="card-result">
        <p><strong>{{sectionName}}</strong></p>
        <p>{{body}}</p>
        <p class="text-bad" style="color:var(--mytros-danger);font-weight:bold;">{{deathsLabel}}</p>
    </div>
</div>
