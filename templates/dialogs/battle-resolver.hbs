<div class="bom-battle-resolver">
  {{#if alliedLegion}}
  <h3>
    <span class="bom-faction-allied">{{alliedLegion.name}}</span>
    <span class="bom-vs">{{localize "BOM.label.vs"}}</span>
    <span class="bom-faction-enemy">{{enemyLegion.name}}</span>
  </h3>

  {{!-- Stats summary --}}
  <div class="bom-resolver-stats">
    <div class="bom-side bom-faction-allied">
      <strong>{{alliedLegion.name}}</strong>
      <span class="bom-resolver-stat-row">V{{alliedStats.vit}} M{{alliedStats.mor}} W{{alliedStats.wit}}</span>
      {{#if alliedCmd}}
      <span class="bom-resolver-cmd">
        {{#if alliedCmd.alive}}<i class="fas fa-crown"></i>{{else}}<i class="fas fa-skull"></i>{{/if}}
        {{alliedCmd.name}}
      </span>
      {{/if}}
    </div>
    <div class="bom-side bom-faction-enemy">
      <strong>{{enemyLegion.name}}</strong>
      <span class="bom-resolver-stat-row">V{{enemyStats.vit}} M{{enemyStats.mor}} W{{enemyStats.wit}}</span>
      {{#if enemyCmd}}
      <span class="bom-resolver-cmd">
        {{#if enemyCmd.alive}}<i class="fas fa-crown"></i>{{else}}<i class="fas fa-skull"></i>{{/if}}
        {{enemyCmd.name}}
      </span>
      {{/if}}
    </div>
  </div>

  {{!-- Counter --}}
  <div class="bom-counter-display">
    <span class="bom-faction-allied">{{results.counterA}}</span>
    <span class="bom-counter-sep">–</span>
    <span class="bom-faction-enemy">{{results.counterB}}</span>
    <span class="bom-counter-label">{{localize "BOM.label.counter"}}</span>
  </div>

  {{!-- Manual modifier row (shown whenever a roll is pending) --}}
  {{#unless (eq step "done")}}
  {{#unless (eq step "maneuverChoice")}}
  <div class="bom-manual-mods">
    <div class="bom-manual-mod bom-faction-allied">
      <label>{{alliedLegion.name}} Mod</label>
      <input type="number" name="manualModA" value="0" class="bom-mod-input" />
    </div>

    {{!-- Tag bonuses preview --}}
    {{#if alliedTagBonuses}}
    <div class="bom-tag-bonuses-preview bom-faction-allied">
      {{#each alliedTagBonuses}}<span class="bom-tag-bonus">+{{this.value}} {{this.label}}</span>{{/each}}
    </div>
    {{/if}}

    {{#if alliedHasFanatic}}
    <button type="button" data-action="toggleFanatic" data-side="a"
      class="bom-fanatic-btn {{#if fanaticA}}bom-fanatic-active{{/if}}">
      <i class="fas fa-fire"></i> Fanatic (+{{fanaticBonus}})
    </button>
    {{/if}}

    <div class="bom-manual-mod bom-faction-enemy">
      <label>{{enemyLegion.name}} Mod</label>
      <input type="number" name="manualModB" value="0" class="bom-mod-input" />
    </div>

    {{#if enemyTagBonuses}}
    <div class="bom-tag-bonuses-preview bom-faction-enemy">
      {{#each enemyTagBonuses}}<span class="bom-tag-bonus">+{{this.value}} {{this.label}}</span>{{/each}}
    </div>
    {{/if}}

    {{#if enemyHasFanatic}}
    <button type="button" data-action="toggleFanatic" data-side="b"
      class="bom-fanatic-btn {{#if fanaticB}}bom-fanatic-active{{/if}}">
      <i class="fas fa-fire"></i> Fanatic (+{{fanaticBonus}})
    </button>
    {{/if}}
  </div>
  {{/unless}}
  {{/unless}}

  {{!-- Step 1: Maneuver --}}
  <div class="bom-resolver-step {{#if results.maneuver}}bom-done{{/if}}">
    <h4><span class="bom-step-num">1</span> {{localize "BOM.battle.maneuver"}} <span class="bom-step-stat">({{localize "BOM.stat.wit"}})</span></h4>
    {{#if results.maneuver}}
      <div class="bom-roll-result-grid">
        <div class="bom-roll-side bom-faction-allied">
          <span class="bom-roll-total {{#if results.maneuver.nat20A}}bom-nat20{{/if}}{{#if results.maneuver.nat1A}} bom-nat1{{/if}}">{{results.maneuver.totalA}}</span>
          <span class="bom-roll-formula">{{results.maneuver.rollA}} + {{results.maneuver.bonusA}}</span>
        </div>
        <span class="bom-vs">vs</span>
        <div class="bom-roll-side bom-faction-enemy">
          <span class="bom-roll-total {{#if results.maneuver.nat20B}}bom-nat20{{/if}}{{#if results.maneuver.nat1B}} bom-nat1{{/if}}">{{results.maneuver.totalB}}</span>
          <span class="bom-roll-formula">{{results.maneuver.rollB}} + {{results.maneuver.bonusB}}</span>
        </div>
        <span class="bom-step-winner bom-faction-{{#if (eq results.maneuver.winner "Allied")}}allied{{else}}{{#if (eq results.maneuver.winner "Enemy")}}enemy{{else}}neutral{{/if}}{{/if}}">
          {{results.maneuver.winner}}
        </span>
      </div>
    {{else}}
      {{#if (eq step "maneuver")}}
        <button type="button" data-action="rollManeuver"><i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}</button>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Maneuver benefit choice --}}
  {{#if (eq step "maneuverChoice")}}
  <div class="bom-resolver-step bom-choice">
    <h4>Choose Maneuver Benefit <span class="bom-step-stat">(winner: {{results.maneuver.winner}})</span></h4>
    {{#each maneuverBenefits}}
    <button type="button" data-action="pickManeuverBenefit" data-benefit="{{this.id}}" class="bom-benefit-btn">
      <strong>{{localize this.label}}</strong> — {{localize this.desc}}
    </button>
    {{/each}}
  </div>
  {{/if}}

  {{!-- Step 2: Charge --}}
  <div class="bom-resolver-step {{#if results.charge}}bom-done{{/if}}">
    <h4><span class="bom-step-num">2</span> {{localize "BOM.battle.charge"}} <span class="bom-step-stat">({{localize "BOM.stat.mor"}})</span></h4>
    {{#if results.charge}}
      <div class="bom-roll-result-grid">
        <div class="bom-roll-side bom-faction-allied">
          <span class="bom-roll-total {{#if results.charge.nat20A}}bom-nat20{{/if}}{{#if results.charge.nat1A}} bom-nat1{{/if}}">{{results.charge.totalA}}</span>
          <span class="bom-roll-formula">{{results.charge.rollA}} + {{results.charge.bonusA}}</span>
        </div>
        <span class="bom-vs">vs</span>
        <div class="bom-roll-side bom-faction-enemy">
          <span class="bom-roll-total {{#if results.charge.nat20B}}bom-nat20{{/if}}{{#if results.charge.nat1B}} bom-nat1{{/if}}">{{results.charge.totalB}}</span>
          <span class="bom-roll-formula">{{results.charge.rollB}} + {{results.charge.bonusB}}</span>
        </div>
        <span class="bom-step-winner bom-faction-{{#if (eq results.charge.winner "Allied")}}allied{{else}}{{#if (eq results.charge.winner "Enemy")}}enemy{{else}}neutral{{/if}}{{/if}}">
          {{results.charge.winner}}
        </span>
      </div>
    {{else}}
      {{#if (eq step "charge")}}
        <button type="button" data-action="rollCharge"><i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}</button>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Step 3: Clash --}}
  <div class="bom-resolver-step {{#if results.clash}}bom-done{{/if}}">
    <h4><span class="bom-step-num">3</span> {{localize "BOM.battle.clash"}} <span class="bom-step-stat">({{localize "BOM.stat.vit"}})</span></h4>
    {{#if results.clash}}
      <div class="bom-roll-result-grid">
        <div class="bom-roll-side bom-faction-allied">
          <span class="bom-roll-total {{#if results.clash.nat20A}}bom-nat20{{/if}}{{#if results.clash.nat1A}} bom-nat1{{/if}}">{{results.clash.totalA}}</span>
          <span class="bom-roll-formula">{{results.clash.rollA}} + {{results.clash.bonusA}}</span>
        </div>
        <span class="bom-vs">vs</span>
        <div class="bom-roll-side bom-faction-enemy">
          <span class="bom-roll-total {{#if results.clash.nat20B}}bom-nat20{{/if}}{{#if results.clash.nat1B}} bom-nat1{{/if}}">{{results.clash.totalB}}</span>
          <span class="bom-roll-formula">{{results.clash.rollB}} + {{results.clash.bonusB}}</span>
        </div>
        <span class="bom-step-winner bom-faction-{{#if (eq results.clash.winner "Allied")}}allied{{else}}{{#if (eq results.clash.winner "Enemy")}}enemy{{else}}neutral{{/if}}{{/if}}">
          {{results.clash.winner}}
        </span>
      </div>
    {{else}}
      {{#if (eq step "clash")}}
        <button type="button" data-action="rollClash"><i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}</button>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Tiebreaker --}}
  {{#if (eq step "tiebreaker")}}
  <div class="bom-resolver-step">
    <h4>{{localize "BOM.battle.tiebreaker"}} <span class="bom-step-stat">({{localize "BOM.stat.vit"}})</span></h4>
    <p class="bom-empty">Counter tied! Sudden-death Vitality roll.</p>
    <button type="button" data-action="rollTiebreaker"><i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}</button>
  </div>
  {{/if}}

  {{!-- Winner --}}
  {{#if (eq step "done")}}
  <div class="bom-resolver-winner bom-faction-{{results.winner}}">
    <h4><i class="fas fa-trophy"></i> {{localize "BOM.label.winner"}}: <strong>{{results.winner}}</strong></h4>
    <span class="bom-counter-score">{{results.counterA}} – {{results.counterB}}</span>
    <button type="button" data-action="finalize"><i class="fas fa-check"></i> Finalize &amp; Post to Chat</button>
  </div>
  {{/if}}

  {{else}}
  <p class="bom-empty">Battle not found.</p>
  {{/if}}
</div>
