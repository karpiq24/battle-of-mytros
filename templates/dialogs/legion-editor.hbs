<div class="bom-legion-editor-form">
  <h3>{{#if isEdit}}{{localize "BOM.action.editLegion"}}{{else}}{{localize "BOM.action.addLegion"}}{{/if}}</h3>

  <div class="form-group">
    <label>{{localize "BOM.label.legionName"}}</label>
    <input type="text" name="name" value="{{legion.name}}" required />
  </div>

  <div class="form-group">
    <label>{{localize "BOM.label.faction"}}</label>
    <select name="faction">
      {{#each factions}}
      <option value="{{this.id}}" {{#if (eq this.id ../legion.faction)}}selected{{/if}}>
        {{localize this.label}}
      </option>
      {{/each}}
    </select>
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.vit"}} (Base)</label>
      <input type="number" name="vitBase" value="{{legion.vitBase}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} (Base)</label>
      <input type="number" name="morBase" value="{{legion.morBase}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.wit"}} (Base)</label>
      <input type="number" name="witBase" value="{{legion.witBase}}" min="0" max="10" />
    </div>
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.injuries"}}</label>
      <input type="number" name="injuries" value="{{legion.injuries}}" min="0" max="6" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} Mod</label>
      <input type="number" name="moraleMod" value="{{legion.moraleMod}}" />
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "BOM.label.commander"}}</label>
    <select name="commanderId">
      <option value="">— {{localize "BOM.label.none"}} —</option>
      {{#each commanders}}
      <option value="{{this.id}}" {{#if (eq this.id ../legion.commanderId)}}selected{{/if}}>
        {{this.name}} ({{localize (concat "BOM.faction." this.faction)}}){{#unless this.alive}} ✝{{/unless}}
      </option>
      {{/each}}
    </select>
  </div>

  <button type="submit"><i class="fas fa-save"></i> {{localize "BOM.action.save"}}</button>
</div>
