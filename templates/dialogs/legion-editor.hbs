<div class="bom-legion-editor-form">
  <h3>{{#if isEdit}}{{localize "BOM.action.editLegion"}}{{else}}{{localize "BOM.action.addLegion"}}{{/if}}</h3>

  {{!-- Legion info --}}
  <div class="form-group">
    <label>{{localize "BOM.label.legionName"}}</label>
    <input type="text" name="name" value="{{legion.name}}" required />
  </div>

  <div class="form-group">
    <label>{{localize "BOM.label.faction"}}</label>
    <select name="faction">
      {{#each factions}}
      <option value="{{this.id}}" {{#if (eq this.id ../legion.faction)}}selected{{/if}}>
        {{localize this.label}}
      </option>
      {{/each}}
    </select>
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.vit"}} (Base)</label>
      <input type="number" name="vitBase" value="{{legion.vitBase}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} (Base)</label>
      <input type="number" name="morBase" value="{{legion.morBase}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.wit"}} (Base)</label>
      <input type="number" name="witBase" value="{{legion.witBase}}" min="0" max="10" />
    </div>
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.injuries"}}</label>
      <input type="number" name="injuries" value="{{legion.injuries}}" min="0" max="6" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} Mod</label>
      <input type="number" name="moraleMod" value="{{legion.moraleMod}}" />
    </div>
  </div>

  <hr />

  {{!-- Commander --}}
  <h4><i class="fas fa-crown"></i> {{localize "BOM.label.commander"}}</h4>

  <div class="form-group">
    <label>{{localize "BOM.label.commanderName"}}</label>
    <input type="text" name="commanderName" value="{{legion.commander.name}}" />
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.vit"}} Bonus</label>
      <input type="number" name="cmdVit" value="{{legion.commander.vitBonus}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} Bonus</label>
      <input type="number" name="cmdMor" value="{{legion.commander.morBonus}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.wit"}} Bonus</label>
      <input type="number" name="cmdWit" value="{{legion.commander.witBonus}}" min="0" max="10" />
    </div>
  </div>

  {{!-- Tags --}}
  <div class="form-group">
    <label>{{localize "BOM.label.tags"}}</label>
    <div class="bom-tag-checkboxes">
      {{#each allTags}}
      <label class="bom-tag-checkbox">
        <input type="checkbox" name="tags.{{this}}"
          {{#each ../legion.commander.tags}}
            {{#if (eq this.name ../this)}}checked{{/if}}
          {{/each}}
        />
        {{this}}
      </label>
      {{/each}}
    </div>
  </div>

  <div class="form-group">
    <label>Commander Alive</label>
    <input type="checkbox" name="cmdAlive" {{#if legion.commander.alive}}checked{{/if}} />
  </div>

  <button type="submit"><i class="fas fa-save"></i> {{localize "BOM.action.save"}}</button>
</div>
