<div class="bom-commander-editor-form">
  <h3>{{#if isEdit}}{{localize "BOM.action.editCommander"}}{{else}}{{localize "BOM.action.addCommander"}}{{/if}}</h3>

  <div class="form-group">
    <label>{{localize "BOM.label.commanderName"}}</label>
    <input type="text" name="name" value="{{commander.name}}" required />
  </div>

  <div class="form-group">
    <label>{{localize "BOM.label.faction"}}</label>
    <select name="faction">
      {{#each factions}}
      <option value="{{this.id}}" {{#if (eq this.id ../commander.faction)}}selected{{/if}}>
        {{localize this.label}}
      </option>
      {{/each}}
    </select>
  </div>

  <div class="form-group-row">
    <div class="form-group">
      <label>{{localize "BOM.stat.vit"}} Bonus</label>
      <input type="number" name="vitBonus" value="{{commander.vitBonus}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.mor"}} Bonus</label>
      <input type="number" name="morBonus" value="{{commander.morBonus}}" min="0" max="10" />
    </div>
    <div class="form-group">
      <label>{{localize "BOM.stat.wit"}} Bonus</label>
      <input type="number" name="witBonus" value="{{commander.witBonus}}" min="0" max="10" />
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "BOM.label.tags"}}</label>
    <div class="bom-tag-checkboxes">
      {{#each allTags}}
      <label class="bom-tag-checkbox">
        <input type="checkbox" name="tags.{{this}}"
          {{#each ../commander.tags}}
            {{#if (eq this.name ../this)}}checked{{/if}}
          {{/each}}
        />
        {{this}}
      </label>
      {{/each}}
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "BOM.status.alive"}}</label>
    <input type="checkbox" name="alive" {{#if commander.alive}}checked{{/if}} />
  </div>

  <button type="submit"><i class="fas fa-save"></i> {{localize "BOM.action.save"}}</button>
</div>
