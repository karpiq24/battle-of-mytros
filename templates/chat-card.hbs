<div class="mytros-battle-card">
    <div class="card-header">
        <i class="fas fa-swords"></i> Battle in <strong>{{sectionName}}</strong>
    </div>

    <div class="card-matchup">
        <span class="faction-allied">{{alliedName}}</span>
        <span class="card-vs">vs</span>
        <span class="faction-sydon">{{sydonName}}</span>
    </div>

    <div class="card-result">
        <strong>{{winnerLabel}}</strong> wins
        <span class="card-score">({{scoreAllied}}–{{scoreSydon}})</span>
    </div>

    <table class="card-table">
        <thead>
            <tr><th></th><th>Allied</th><th>Sydon</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>Recovery</td>
                <td class="{{alliedRecoveryClass}}">{{alliedRecoveryText}}</td>
                <td class="{{sydonRecoveryClass}}">{{sydonRecoveryText}}</td>
            </tr>
            <tr>
                <td>Hope</td>
                <td class="{{alliedHopeClass}}">{{alliedHopeText}}</td>
                <td class="{{sydonHopeClass}}">{{sydonHopeText}}</td>
            </tr>
            <tr class="card-final">
                <td>Final State</td>
                <td>Inj <strong>{{alliedInjuries}}</strong> · Mor <strong>{{alliedMorale}}</strong></td>
                <td>Inj <strong>{{sydonInjuries}}</strong> · Mor <strong>{{sydonMorale}}</strong></td>
            </tr>
        </tbody>
    </table>

    {{#if alliedCommanderDied}}
    <p class="card-death"><i class="fas fa-skull"></i> {{alliedCommanderName}} has fallen in battle!</p>
    {{/if}}
    {{#if sydonCommanderDied}}
    <p class="card-death"><i class="fas fa-skull"></i> {{sydonCommanderName}} has fallen in battle!</p>
    {{/if}}

    {{#if alliedStatus}}
    <p class="card-status card-status-{{alliedStatusType}}"><i class="fas fa-exclamation-triangle"></i> Allied: {{alliedStatus}}</p>
    {{/if}}
    {{#if sydonStatus}}
    <p class="card-status card-status-{{sydonStatusType}}"><i class="fas fa-exclamation-triangle"></i> Sydon: {{sydonStatus}}</p>
    {{/if}}

    <div class="card-toll">
        <i class="fas fa-skull-crossbones"></i> Civilian deaths this engagement: ~{{deathToll}}
    </div>
</div>
