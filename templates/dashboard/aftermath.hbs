<section class="tab bom-aftermath-tab {{#if (eq activeTab 'aftermath')}}active{{/if}}" data-tab="aftermath" data-group="sheet">

  <h3>{{localize "BOM.tab.aftermath"}}</h3>

  <div class="bom-aftermath-list">
    {{#each state.battles}}
      {{#if this.resolved}}
      <div class="bom-aftermath-card">
        <div class="bom-aftermath-header">
          {{#with (lookup @root.legions (findIndex @root.legions "id" this.alliedLegionId))}}
            <span class="bom-faction-allied">{{this.name}}</span>
          {{/with}}
          <span class="bom-vs">{{localize "BOM.label.vs"}}</span>
          {{#with (lookup @root.legions (findIndex @root.legions "id" this.enemyLegionId))}}
            <span class="bom-faction-enemy">{{this.name}}</span>
          {{/with}}
          <span class="bom-winner-badge bom-faction-{{this.winner}}">{{localize "BOM.label.winner"}}: {{this.winner}}</span>
        </div>

        <div class="bom-aftermath-checks">

          {{!-- Recovery --}}
          <div class="bom-check-row">
            <span class="bom-check-label">{{localize "BOM.aftermath.recovery"}}</span>
            {{#if this.aftermathDone.recovery}}
              <span class="bom-check-done"><i class="fas fa-check"></i> Done</span>
            {{else}}
              <div class="bom-check-inputs">
                <div class="bom-check-input-group bom-faction-allied">
                  <label>Allied Mod</label>
                  <input type="number" name="modAllied_recovery" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advAllied_recovery" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvAllied_recovery" /> Disadv</label>
                </div>
                <div class="bom-check-input-group bom-faction-enemy">
                  <label>Enemy Mod</label>
                  <input type="number" name="modEnemy_recovery" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advEnemy_recovery" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvEnemy_recovery" /> Disadv</label>
                </div>
                <button type="button" data-action="resolveAftermath" data-battle-id="{{this.id}}" data-check="recovery">
                  <i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}
                </button>
              </div>
            {{/if}}
          </div>

          {{!-- Hope --}}
          <div class="bom-check-row">
            <span class="bom-check-label">{{localize "BOM.aftermath.hope"}}</span>
            {{#if this.aftermathDone.hope}}
              <span class="bom-check-done"><i class="fas fa-check"></i> Done</span>
            {{else}}
              <div class="bom-check-inputs">
                <div class="bom-check-input-group bom-faction-allied">
                  <label>Allied Mod</label>
                  <input type="number" name="modAllied_hope" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advAllied_hope" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvAllied_hope" /> Disadv</label>
                </div>
                <div class="bom-check-input-group bom-faction-enemy">
                  <label>Enemy Mod</label>
                  <input type="number" name="modEnemy_hope" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advEnemy_hope" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvEnemy_hope" /> Disadv</label>
                </div>
                <button type="button" data-action="resolveAftermath" data-battle-id="{{this.id}}" data-check="hope">
                  <i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}
                </button>
              </div>
            {{/if}}
          </div>

          {{!-- Salvage (winner only) --}}
          <div class="bom-check-row">
            <span class="bom-check-label">{{localize "BOM.aftermath.salvage"}}</span>
            {{#if this.aftermathDone.salvage}}
              <span class="bom-check-done"><i class="fas fa-check"></i> Done</span>
            {{else}}
              <div class="bom-check-inputs">
                <div class="bom-check-input-group bom-faction-{{this.winner}}">
                  <label>Winner Mod</label>
                  <input type="number" name="modWinner_salvage" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advWinner_salvage" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvWinner_salvage" /> Disadv</label>
                </div>
                <button type="button" data-action="resolveAftermath" data-battle-id="{{this.id}}" data-check="salvage">
                  <i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}
                </button>
              </div>
            {{/if}}
          </div>

          {{!-- Commander Casualty --}}
          <div class="bom-check-row">
            <span class="bom-check-label">{{localize "BOM.aftermath.casualty"}}</span>
            {{#if this.aftermathDone.casualty}}
              <span class="bom-check-done"><i class="fas fa-check"></i> Done</span>
            {{else}}
              <div class="bom-check-inputs">
                <div class="bom-check-input-group bom-faction-allied">
                  <label>Allied Mod</label>
                  <input type="number" name="modAllied_casualty" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advAllied_casualty" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvAllied_casualty" /> Disadv</label>
                </div>
                <div class="bom-check-input-group bom-faction-enemy">
                  <label>Enemy Mod</label>
                  <input type="number" name="modEnemy_casualty" value="0" class="bom-mod-input" />
                  <label class="bom-adv-label"><input type="checkbox" name="advEnemy_casualty" /> Adv</label>
                  <label class="bom-adv-label"><input type="checkbox" name="disadvEnemy_casualty" /> Disadv</label>
                </div>
                <button type="button" data-action="resolveAftermath" data-battle-id="{{this.id}}" data-check="casualty">
                  <i class="fas fa-dice-d20"></i> {{localize "BOM.action.roll"}}
                </button>
              </div>
            {{/if}}
          </div>

        </div>
      </div>
      {{/if}}
    {{/each}}

    {{#unless state.battles.length}}
    <p class="bom-empty">{{localize "BOM.label.none"}}</p>
    {{/unless}}
  </div>

</section>
