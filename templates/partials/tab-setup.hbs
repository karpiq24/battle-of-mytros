<div class="setup-form">
    <h3><i class="fas fa-map"></i> {{localize "MYTROS.SetupSectionScene"}}</h3>
    <div class="form-group">
        <label>{{localize "MYTROS.SetupBattleScene"}}</label>
        <select data-setting-input data-setting="battleSceneId">
            <option value="">— {{localize "MYTROS.SetupBattleSceneNone"}} —</option>
            {{#each scenes}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "MYTROS.SetupSectionPrefix"}}</label>
        <span class="setup-value">{{sectionPrefix}}</span>
    </div>

    <hr>
    <h3><i class="fas fa-calendar"></i> {{localize "MYTROS.SetupBattleState"}}</h3>
    <div class="form-group">
        <label>{{localize "MYTROS.SetupRoundLabel"}}</label>
        <input type="number" data-setting-input data-setting="currentRound" value="{{round}}">
    </div>
    <div class="form-group">
        <label>{{localize "MYTROS.SetupPhaseLabel"}}</label>
        <input type="number" data-setting-input data-setting="currentPhase" value="{{phase}}">
    </div>
    <div class="form-group">
        <label>{{localize "MYTROS.AlliedMiracles"}}</label>
        <input type="number" data-setting-input data-setting="alliedMiracles" value="{{alliedMiracles}}">
    </div>
    <div class="form-group">
        <label>{{localize "MYTROS.SydonMiracles"}}</label>
        <input type="number" data-setting-input data-setting="sydonMiracles" value="{{sydonMiracles}}">
    </div>
    <div class="form-group">
        <label>{{localize "MYTROS.SetupDeathTollLabel"}}</label>
        <input type="number" data-setting-input data-setting="deathToll" value="{{deathToll}}">
    </div>
    <div class="form-group form-group-checkbox">
        <label>{{localize "MYTROS.SetupDeathTollFrozen"}}</label>
        <input type="checkbox" data-action="updateSetting" data-setting="deathTollFrozen" {{#if deathTollFrozen}}checked{{/if}}>
    </div>
    <div class="form-group form-group-checkbox">
        <label>{{localize "MYTROS.SetupSydonObjectiveHalved"}}</label>
        <input type="checkbox" data-action="updateSetting" data-setting="sydonObjectiveHalved" {{#if sydonObjectiveHalved}}checked{{/if}}>
    </div>

    <hr>
    <h3><i class="fas fa-sliders"></i> {{localize "MYTROS.SetupRules"}}</h3>
    <p class="setup-rules-hint">{{localize "MYTROS.SetupRulesHint"}}</p>
    <div class="setup-rules-summary">
        <span>{{localize "MYTROS.SetupMaxMorale"}}: <strong>{{maxMorale}}</strong></span>
        <span>{{localize "MYTROS.SetupDestroyThreshold"}}: <strong>{{destroyThreshold}}</strong></span>
        <span>{{localize "MYTROS.SetupHopeDC"}}: <strong>{{hopeDC}}</strong></span>
        <span>{{localize "MYTROS.SetupSalvageDC"}}: <strong>{{salvageDC}}</strong></span>
    </div>

    <hr>
    <h3><i class="fas fa-bullseye"></i> {{localize "MYTROS.StrategicObjectivesTitle"}}</h3>
    {{#if objectivesDef.length}}
    <div class="config-items">
        {{#each objectivesDef}}
        <div class="config-item">
            <span>{{this.name}}</span>
            <span class="config-reward">+{{this.reward}}</span>
            <button type="button" data-action="removeObjective" data-index="{{@index}}" title="{{localize "MYTROS.Delete"}}">×</button>
        </div>
        {{/each}}
    </div>
    {{/if}}
    <div class="form-group">
        <button type="button" data-action="addObjective"><i class="fas fa-plus"></i> {{localize "MYTROS.AddObjective"}}</button>
    </div>

    <hr>
    <h3><i class="fas fa-bolt"></i> {{localize "MYTROS.MajorEventsTitle"}}</h3>
    {{#if majorEventsDef.length}}
    <div class="config-items">
        {{#each majorEventsDef}}
        <div class="config-item">
            <span>{{this.name}}</span>
            <span class="config-reward">+{{this.reward}}</span>
            <button type="button" data-action="removeMajorEvent" data-index="{{@index}}" title="{{localize "MYTROS.Delete"}}">×</button>
        </div>
        {{/each}}
    </div>
    {{/if}}
    <div class="form-group">
        <button type="button" data-action="addMajorEvent"><i class="fas fa-plus"></i> {{localize "MYTROS.AddEvent"}}</button>
    </div>
    <div class="form-group">
        <button type="button" data-action="resetObjectivesAndEvents" class="btn-danger-subtle"><i class="fas fa-rotate-left"></i> {{localize "MYTROS.ResetDefaults"}}</button>
    </div>

    <hr>
    <div class="form-group">
        <button type="button" class="advance-round-btn" data-action="advanceRound"><i class="fas fa-forward"></i> {{localize "MYTROS.AdvanceRound"}} {{add round 1}}</button>
    </div>

    <hr>
    <h3><i class="fas fa-link"></i> {{localize "MYTROS.AdjacencyTitle"}}</h3>
    <p class="adjacency-hint">{{localize "MYTROS.AdjacencyHint"}}</p>
    {{#if adjacencyPairs.length}}
    <div class="adjacency-pairs">
        {{#each adjacencyPairs}}
        <div class="adjacency-pair">
            <span>{{this.aName}} ↔ {{this.bName}}</span>
            <button type="button" data-action="removeAdjacencyPair" data-index="{{this.index}}">×</button>
        </div>
        {{/each}}
    </div>
    {{/if}}
    <div class="adjacency-add-row">
        <select data-ref="adjA">
            {{#each sectionOpts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        <span>↔</span>
        <select data-ref="adjB">
            {{#each sectionOpts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        <button type="button" data-action="addAdjacencyPair"><i class="fas fa-plus"></i> {{localize "MYTROS.AdjacencyAdd"}}</button>
    </div>

    <hr>
    <h3><i class="fas fa-database"></i> {{localize "MYTROS.DataManagement"}}</h3>
    <div class="form-group data-mgmt-group">
        <button type="button" data-action="importCSV" data-type="legion"><i class="fas fa-file-import"></i> {{localize "MYTROS.ImportLegions"}}</button>
        <button type="button" data-action="exportCSV" data-type="legion"><i class="fas fa-file-export"></i> {{localize "MYTROS.ExportLegions"}}</button>
    </div>
    <div class="form-group data-mgmt-group">
        <button type="button" data-action="importCSV" data-type="commander"><i class="fas fa-file-import"></i> {{localize "MYTROS.ImportCommanders"}}</button>
        <button type="button" data-action="exportCSV" data-type="commander"><i class="fas fa-file-export"></i> {{localize "MYTROS.ExportCommanders"}}</button>
    </div>

    <hr>
    <div class="form-group">
        <button type="button" data-action="resetBattle" class="btn-danger-subtle"><i class="fas fa-skull-crossbones"></i> {{localize "MYTROS.ResetBattle"}}</button>
    </div>

</div>
