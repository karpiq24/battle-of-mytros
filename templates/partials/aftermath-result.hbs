<div class="bom-aftermath-result">
  <span class="bom-check-name">{{check.name}}</span>
  <span class="bom-check-detail">
    d20({{check.roll}}) + {{check.bonus}} = {{check.total}} vs DC {{check.dc}}
    {{#if check.passed}}
      <span class="bom-pass"><i class="fas fa-check"></i> Pass</span>
    {{else}}
      <span class="bom-fail"><i class="fas fa-xmark"></i> Fail</span>
    {{/if}}
  </span>
  {{#if check.effect}}
  <span class="bom-effect">{{check.effect}}</span>
  {{/if}}
</div>
