<div class="bom-phase-result">
  <span class="bom-phase-name">{{phase.phaseName}}</span>
  <span class="bom-roll bom-faction-allied">
    {{phase.rollA}} + {{phase.bonusA}} = {{phase.totalA}}
    {{#if phase.nat20A}}<span class="bom-nat20">{{localize "BOM.nat20"}}</span>{{/if}}
    {{#if phase.nat1A}}<span class="bom-nat1">{{localize "BOM.nat1"}}</span>{{/if}}
  </span>
  <span class="bom-vs">{{localize "BOM.label.vs"}}</span>
  <span class="bom-roll bom-faction-enemy">
    {{phase.rollB}} + {{phase.bonusB}} = {{phase.totalB}}
    {{#if phase.nat20B}}<span class="bom-nat20">{{localize "BOM.nat20"}}</span>{{/if}}
    {{#if phase.nat1B}}<span class="bom-nat1">{{localize "BOM.nat1"}}</span>{{/if}}
  </span>
  <span class="bom-phase-winner">{{phase.winner}}</span>
</div>
