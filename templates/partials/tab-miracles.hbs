<div class="miracles-panel">
    <div class="miracle-pools">
        <div class="miracle-pool pool-allied">
            <h3><i class="fas fa-sun"></i> {{localize "MYTROS.AlliedMiracles"}}</h3>
            <div class="pool-count">{{alliedMiracles}}</div>
            {{#if isGM}}
            <div class="miracle-spend-group">
                <div class="miracle-select-row">
                    <select class="miracle-legion-select" id="allied-miracle-legion">
                        {{#each activeAlliedLegions}}
                        <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-type="healing" data-cost="1"><i class="fas fa-heart"></i> {{localize "MYTROS.SpendHealing"}}</button>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-type="morale" data-cost="1"><i class="fas fa-fist-raised"></i> {{localize "MYTROS.SpendMorale"}}</button>
                <div class="miracle-divider"></div>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="2"><i class="fas fa-campground"></i> {{localize "MYTROS.SpendShortRest"}}</button>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="allied" data-cost="4"><i class="fas fa-bed"></i> {{localize "MYTROS.SpendLongRest"}}</button>
            </div>
            {{/if}}
        </div>
        <div class="miracle-pool pool-sydon">
            <h3><i class="fas fa-bolt"></i> {{localize "MYTROS.SydonMiracles"}}</h3>
            <div class="pool-count">{{sydonMiracles}}</div>
            {{#if isGM}}
            <div class="miracle-spend-group">
                <div class="miracle-select-row">
                    <select class="miracle-legion-select" id="sydon-miracle-legion">
                        {{#each activeSydonLegions}}
                        <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-type="healing" data-cost="1"><i class="fas fa-heart"></i> {{localize "MYTROS.SpendHealing"}}</button>
                <button type="button" class="miracle-spend-btn" data-action="spendMiracle" data-faction="sydon" data-type="morale" data-cost="1"><i class="fas fa-fist-raised"></i> {{localize "MYTROS.SpendMorale"}}</button>
            </div>
            {{/if}}
        </div>
    </div>

    {{#if isGM}}
    <hr>
    <h3><i class="fas fa-star"></i> {{localize "MYTROS.MajorEventsTitle"}}</h3>
    <div class="major-events-list">
        {{#each majorEvents}}
        <div class="event-item {{#if this.completed}}event-completed{{/if}}">
            <div class="event-info">
                <strong>{{this.name}}</strong>
                <span class="event-desc">{{this.description}}</span>
            </div>
            {{#if this.completed}}
            <span class="event-done"><i class="fas fa-check-circle"></i> {{localize "MYTROS.EventResolved"}} (+{{this.reward}} {{localize "MYTROS.Miracles"}})</span>
            {{else}}
            <button type="button" class="event-trigger-btn" data-action="triggerMajorEvent" data-event-id="{{this.id}}">
                <i class="fas fa-bolt"></i> {{localize "MYTROS.EventTriggerBtn"}} (+{{this.reward}} {{localize "MYTROS.AlliedMiracles"}})
            </button>
            {{/if}}
        </div>
        {{/each}}
    </div>
    <hr>
    <h3><i class="fas fa-map-pin"></i> {{localize "MYTROS.StrategicObjectivesTitle"}}</h3>
    <div class="major-events-list">
        {{#each strategicObjectives}}
        <div class="event-item {{#if this.destroyed}}event-completed{{/if}}">
            <div class="event-info">
                <strong>{{this.name}}</strong>
                <span class="event-desc">{{localize "MYTROS.ObjectiveHint"}}</span>
            </div>
            {{#if this.destroyed}}
            <span class="event-done"><i class="fas fa-fire"></i> {{localize "MYTROS.Destroyed"}} (+{{this.reward}} {{localize "MYTROS.Miracles"}})</span>
            {{else}}
            <button type="button" class="event-trigger-btn btn-danger-subtle" data-action="triggerObjectiveDestroyed" data-obj-id="{{this.id}}">
                <i class="fas fa-fire"></i> {{localize "MYTROS.ObjectiveDestroyBtn"}} (+{{this.reward}} {{localize "MYTROS.SydonMiracles"}})
            </button>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}
</div>
